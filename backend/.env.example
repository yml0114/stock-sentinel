AI_API_KEY=your-api-key-here
AI_API_URL=https://api.tokex.top/v1
AI_MODEL=mimov2.5pro

# ── 腾讯云SMS（免费100条/月）──
# 需要在腾讯云控制台开通短信服务，申请签名+模板
# SecretId/SecretKey: https://console.cloud.tencent.com/cam/capi
# SmsSdkAppId: 短信控制台 → 应用管理 → 应用列表
# SignName: 短信控制台 → 国内短信 → 签名管理
# TemplateId: 短信控制台 → 国内短信 → 正文模板管理（模板内容: 您的验证码是{1}，5分钟内有效。）
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ── JWT ──
JWT_SECRET=stock-sentinel-secret-key-2026

# ── ntfy.sh（备用推送）──
NTFY_TOPIC=stock-sentinel
